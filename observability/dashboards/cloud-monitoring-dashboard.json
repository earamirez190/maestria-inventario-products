{
  "displayName": "Maestria Inventario - Observabilidad y Chaos Engineering",
  "etag": "65f1ea70b180de8bf2d0649ea8f60bb8",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "Errores data-service (rate)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/data_service_errors\" resource.type=\"k8s_container\" resource.labels.namespace_name=\"actividad1\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              }
            }
          ],
          "thresholds": [
            {
              "value": 0.01,
              "targetAxis": "Y1",
              "label": "Umbral alerta"
            }
          ],
          "yAxis": {
            "label": "errores/s",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Latencia p99 data-service",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/data_service_latency_distribution\" resource.type=\"k8s_container\" resource.labels.namespace_name=\"actividad1\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_99",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                }
              }
            }
          ],
          "thresholds": [
            {
              "value": 0.2,
              "targetAxis": "Y1",
              "label": "SLO 200 ms"
            }
          ],
          "yAxis": {
            "label": "segundos",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "CPU de contenedores GKE",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"kubernetes.io/container/cpu/limit_utilization\" resource.type=\"k8s_container\" resource.labels.namespace_name=\"actividad1\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "utilización",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Memoria usada en contenedores GKE",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"kubernetes.io/container/memory/used_bytes\" resource.type=\"k8s_container\" resource.labels.namespace_name=\"actividad1\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "bytes",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Logs de consultas y errores",
        "logsPanel": {
          "filter": "resource.type=\"k8s_container\" AND resource.labels.namespace_name=\"actividad1\" AND (jsonPayload.message=\"Products query completada\" OR jsonPayload.message=\"Chaos: error inyectado\")",
          "resourceNames": ["projects/mydemo-505323"]
        }
      },
      {
        "title": "Estado del laboratorio",
        "text": {
          "content": "Sandbox GKE actividad1. Las métricas de aplicación se consultan mediante métricas logs-based de Cloud Monitoring. Las trazas se consultan en Cloud Trace usando el trace_id de la respuesta o de Cloud Logging.",
          "format": "MARKDOWN"
        }
      }
    ]
  }
}
