{
  "displayName": "Chaos Engineering — GKE / Maestria Inventario (Resumen)",
  "etag": "BwW_placeholder",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "App — Latencia (p50/p95/p99) (custom metric placeholder)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/http/server_latency\" resource.type=\"k8s_container\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_PERCENTILE_50",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/http/server_latency\" resource.type=\"k8s_container\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/http/server_latency\" resource.type=\"k8s_container\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_PERCENTILE_99",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ],
          "timeshiftDuration": "0s"
        }
      },
      {
        "title": "App — Error rate (5xx) (custom metric placeholder)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"custom.googleapis.com/http/error_count\" resource.type=\"k8s_container\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Requests / s (Load Balancer)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"loadbalancing.googleapis.com/https/request_count\" resource.type=\"http_load_balancer\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Backend Latency (Load Balancer)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"loadbalancing.googleapis.com/https/backend_latencies\" resource.type=\"http_load_balancer\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Pod CPU utilization (k8s containers) — namespace actividad1",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"container.googleapis.com/container/cpu/utilization\" resource.type=\"k8s_container\" metric.label.\"namespace_name\"=\"actividad1\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_MEAN",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Pod Memory used (bytes) — namespace actividad1",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"container.googleapis.com/container/memory/working_set_bytes\" resource.type=\"k8s_container\" metric.label.\"namespace_name\"=\"actividad1\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_MEAN",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Pod restarts (restarts count) — namespace actividad1",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"kubernetes.io/container/restart_count\" resource.type=\"k8s_container\" metric.label.\"namespace_name\"=\"actividad1\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_DELTA",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Node CPU utilization (GCE instances / GKE nodes)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_MEAN",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Node memory used % (agent) — if monitoring agent installed",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"agent.googleapis.com/memory/percent_used\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_MEAN",
                    "alignmentPeriod": "60s"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Disk IO (read/write bytes) — nodes",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/disk/read_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s" }
                }
              }
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/disk/write_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s" }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Network — instance traffic (bytes sent/received)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/network/sent_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s" }
                }
              }
            },
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/network/received_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": { "perSeriesAligner": "ALIGN_RATE", "alignmentPeriod": "60s" }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Chaos experiment — simple marker (use custom metric to record experiment start/stop)",
        "text": {
          "content": "Nota: Si quieres ver el timeline del experimento aquí, registra un custom metric `custom.googleapis.com/chaos/experiment_status` con values start/stop o usa logs-based metric. Este dashboard está filtrado al namespace actividad1 y la app esperada es app=maestria-inventario-products."
        }
      }
    ]
  },
  "timeout": "0s"
}