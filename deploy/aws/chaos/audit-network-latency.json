{
  "description": "Controlled one-minute network latency on one audit ECS Fargate task.",
  "targets": {
    "AuditTasks": {
      "resourceType": "aws:ecs:task",
      "resourceTags": {
        "ChaosTarget": "audit"
      },
      "filters": [
        {
          "path": "ClusterArn",
          "values": [
            "REPLACE_WITH_ECS_CLUSTER_ARN"
          ]
        }
      ],
      "selectionMode": "COUNT(1)"
    }
  },
  "actions": {
    "AuditNetworkLatency": {
      "actionId": "aws:ecs:task-network-latency",
      "parameters": {
        "duration": "PT1M",
        "delayMilliseconds": "250",
        "jitterMilliseconds": "25",
        "flowsPercent": "100",
        "sources": "ALL",
        "installDependencies": "True",
        "useEcsFaultInjectionEndpoints": "true"
      },
      "targets": {
        "Tasks": "AuditTasks"
      }
    }
  },
  "stopConditions": [
    {
      "source": "aws:cloudwatch:alarm",
      "value": "REPLACE_WITH_CHAOS_STOP_ALARM_5XX_ARN"
    },
    {
      "source": "aws:cloudwatch:alarm",
      "value": "REPLACE_WITH_CHAOS_STOP_ALARM_UNHEALTHY_ARN"
    }
  ],
  "roleArn": "REPLACE_WITH_FIS_EXPERIMENT_ROLE_ARN",
  "tags": {
    "Purpose": "controlled-chaos-lab",
    "ChaosTarget": "audit"
  }
}
