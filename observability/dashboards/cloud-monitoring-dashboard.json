{
  "displayName": "Maestria Inventario - Observabilidad y Chaos Engineering",
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "Throughput (Requests/sec)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "prometheusQuery": "sum(rate(http_server_requests_seconds_count[5m]))"
              }
            }
          ]
        }
      },
      {
        "title": "Latencia Promedio",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "prometheusQuery": "rate(http_server_requests_seconds_sum[5m]) / rate(http_server_requests_seconds_count[5m])"
              }
            }
          ]
        }
      },
      {
        "title": "Latencia P50",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "histogram_quantile(0.50,sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"
              }
            }
          ]
        }
      },
      {
        "title": "Latencia P95",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "histogram_quantile(0.95,sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"
              }
            }
          ]
        }
      },
      {
        "title": "Latencia P99",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "histogram_quantile(0.99,sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"
              }
            }
          ]
        }
      },
      {
        "title": "CPU Aplicacion",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "process_cpu_usage"
              }
            }
          ]
        }
      },
      {
        "title": "CPU Sistema",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "system_cpu_usage"
              }
            }
          ]
        }
      },
      {
        "title": "Memoria JVM Utilizada",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "jvm_memory_used_bytes"
              }
            }
          ]
        }
      },
      {
        "title": "Memoria JVM Commit",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "jvm_memory_committed_bytes"
              }
            }
          ]
        }
      },
      {
        "title": "Pausas GC",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "rate(jvm_gc_pause_seconds_count[5m])"
              }
            }
          ]
        }
      },
      {
        "title": "JDBC Conexiones Activas",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "jdbc_connections_active"
              }
            }
          ]
        }
      },
      {
        "title": "JDBC Conexiones Idle",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "jdbc_connections_idle"
              }
            }
          ]
        }
      },
      {
        "title": "HikariCP Activas",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "hikaricp_connections_active"
              }
            }
          ]
        }
      },
      {
        "title": "HikariCP Idle",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "hikaricp_connections_idle"
              }
            }
          ]
        }
      },
      {
        "title": "HikariCP Pendientes",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "hikaricp_connections_pending"
              }
            }
          ]
        }
      },
      {
        "title": "Disponibilidad Servicio",
        "scorecard": {
          "timeSeriesQuery": {
            "prometheusQuery": "avg(up) * 100"
          }
        }
      },
      {
        "title": "OTEL Spans Exportados",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "rate(otelcol_exporter_sent_spans[5m])"
              }
            }
          ]
        }
      },
      {
        "title": "OTEL Incoming Items",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "rate(otelcol_processor_incoming_items[5m])"
              }
            }
          ]
        }
      },
      {
        "title": "OTEL Outgoing Items",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "prometheusQuery": "rate(otelcol_processor_outgoing_items[5m])"
              }
            }
          ]
        }
      },
      {
        "title": "Estado Chaos Engineering",
        "text": {
          "content": "Validar durante experimentos Litmus: incremento P95/P99, reducción throughput, aumento CPU y variación de spans de OpenTelemetry."
        }
      }
    ]
  }
}